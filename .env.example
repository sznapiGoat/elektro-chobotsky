# Odesílání poptávek e-mailem přes Resend.
# Bez těchto proměnných formulář nabídne odeslání přes e-mailový klient.
RESEND_API_KEY=
# Adresa, ze které se poptávky posílají. Doména musí být v Resendu ověřená.
CONTACT_FROM=poptavka@example.cz
# Kam poptávky chodí. Bez nastavení se použije e-mail ze lib/site.ts.
CONTACT_TO=chobotskymiroslav@seznam.cz
